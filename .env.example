# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already in .gitignore.

# Supabase (free tier project) — https://supabase.com
# Safe to expose in the mobile app: the anon key only works within
# the Row Level Security (RLS) policies configured on the database.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Donation link (existing WIC payment provider page, e.g. Zeffy / PayPal Giving / Stripe Payment Link)
EXPO_PUBLIC_DONATION_URL=https://your-existing-donation-page.example.com
EXPO_PUBLIC_BUILDING_FUND_DONATION_URL=https://your-existing-donation-page.example.com/building-fund
